# Copy this file to .env and fill in a key. .env is gitignored; never commit real keys.

# Groq (free tier, default provider): https://console.groq.com -> API Keys
GROQ_API_KEY=

# Or OpenAI / any OpenAI-compatible server
OPENAI_API_KEY=
# LLM_BASE_URL=

# Optional overrides (defaults: groq / llama-3.3-70b-versatile / llama-3.1-8b-instant)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_JUDGE_MODEL=llama-3.1-8b-instant
